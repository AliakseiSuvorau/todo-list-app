<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background"
    android:padding="24sp">

    <EditText
        android:id="@+id/user_filter_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter filter name" />

    <FrameLayout
        android:id="@+id/tags_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <CheckBox
        android:id="@+id/checkbox_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="Show only finished tasks" />

    <Button
        android:id="@+id/pick_deadline_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/button_background"
        android:stateListAnimator="@null"
        android:text="Deadline" />

    <NumberPicker
        android:id="@+id/difficulty_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:orientation="horizontal">

        <Button
            android:id="@+id/add_filter_save_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:stateListAnimator="@null"
            android:layout_marginEnd="5dp"
            android:text="Save" />

        <Button
            android:id="@+id/add_filter_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:stateListAnimator="@null"
            android:layout_marginStart="5dp"
            android:text="Cancel" />

    </LinearLayout>

</LinearLayout>
